function PlanetSurface({
  radius,
  color,
  selected,
  connecting,
}: {
  radius: number;
  color: string;
  selected: boolean;
  connecting: boolean;
}) {
  const surface = useRef<THREE.Mesh>(null);
  const energy = useRef<THREE.Mesh>(null);
  const halo = useRef<THREE.Mesh>(null);

  const shader = useMemo(
    () => ({
      uniforms: {
        uTime: { value: 0 },
        uColor: { value: new THREE.Color(color) },
        uIntensity: { value: 1 },
      },
      vertexShader: `
        varying vec3 vNormal;
        varying vec3 vPosition;
        varying vec3 vWorldPosition;
        uniform float uTime;

        void main() {
          vNormal = normalize(mat3(modelMatrix) * normal);
          vPosition = position;

          vec3 transformed = position;
          float wave =
            sin(position.y * 8.0 + uTime * 0.65) *
            sin(position.x * 7.0 - uTime * 0.4);

          transformed += normal * wave * 0.018;

          vec4 worldPosition =
            modelMatrix * vec4(transformed, 1.0);

          vWorldPosition = worldPosition.xyz;

          gl_Position =
            projectionMatrix *
            viewMatrix *
            worldPosition;
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform vec3 uColor;
        uniform float uIntensity;

        varying vec3 vNormal;
        varying vec3 vPosition;
        varying vec3 vWorldPosition;

        void main() {
          vec3 normal = normalize(vNormal);
          vec3 viewDirection =
            normalize(cameraPosition - vWorldPosition);

          float fresnel = pow(
            1.0 - abs(dot(normal, viewDirection)),
            2.5
          );

          float latitude = sin(
            vPosition.y * 13.0 +
            sin(vPosition.x * 7.0 + uTime * 0.3) * 1.5 +
            uTime * 0.35
          );

          float longitude = sin(
            vPosition.x * 11.0 -
            vPosition.z * 8.0 -
            uTime * 0.25
          );

          float energyPattern = smoothstep(
            0.45,
            0.95,
            latitude * longitude
          );

          float shimmer =
            0.5 +
            0.5 * sin(
              vPosition.y * 22.0 +
              vPosition.x * 12.0 +
              uTime * 0.6
            );

          vec3 darkColor = uColor * 0.12;
          vec3 brightColor =
            mix(uColor, vec3(1.0), 0.45);

          vec3 finalColor = mix(
            darkColor,
            uColor * 0.85,
            shimmer * 0.6
          );

          finalColor +=
            brightColor * energyPattern * 1.15;

          finalColor +=
            brightColor * fresnel * 1.4;

          finalColor *= uIntensity;

          gl_FragColor = vec4(finalColor, 1.0);
        }
      `,
    }),
    [color]
  );

  useFrame((state, delta) => {
    shader.uniforms.uTime.value =
      state.clock.elapsedTime;

    shader.uniforms.uIntensity.value =
      selected || connecting ? 1.5 : 1;

    if (surface.current) {
      surface.current.rotation.y += delta * 0.08;
    }

    if (energy.current) {
      energy.current.rotation.y -= delta * 0.14;
      energy.current.rotation.z += delta * 0.035;
    }

    if (halo.current) {
      const pulse =
        1.22 +
        Math.sin(state.clock.elapsedTime * 1.3) * 0.025;

      halo.current.scale.setScalar(pulse);
    }
  });

  return (
    <group>
      <mesh ref={surface}>
        <sphereGeometry args={[radius, 96, 96]} />
        <shaderMaterial
          uniforms={shader.uniforms}
          vertexShader={shader.vertexShader}
          fragmentShader={shader.fragmentShader}
        />
      </mesh>

      <mesh ref={energy} scale={1.045}>
        <sphereGeometry args={[radius, 64, 64]} />
        <meshBasicMaterial
          color={color}
          wireframe
          transparent
          opacity={0.075}
          depthWrite={false}
          blending={THREE.AdditiveBlending}
        />
      </mesh>

      <mesh ref={halo}>
        <sphereGeometry args={[radius, 64, 64]} />
        <meshBasicMaterial
          color={color}
          transparent
          opacity={selected || connecting ? 0.17 : 0.085}
          side={THREE.BackSide}
          depthWrite={false}
          blending={THREE.AdditiveBlending}
        />
      </mesh>

      <mesh scale={1.42}>
        <sphereGeometry args={[radius, 48, 48]} />
        <meshBasicMaterial
          color={color}
          transparent
          opacity={0.025}
          side={THREE.BackSide}
          depthWrite={false}
          blending={THREE.AdditiveBlending}
        />
      </mesh>
    </group>
  );
}

function PlanetParticles({
  radius,
  color,
  count,
}: {
  radius: number;
  color: string;
  count: number;
}) {
  const points = useRef<THREE.Points>(null);

  const positions = useMemo(() => {
    const result = new Float32Array(count * 3);

    for (let i = 0; i < count; i++) {
      const angle = Math.random() * Math.PI * 2;
      const distance =
        radius * (1.5 + Math.random() * 1.1);
      const height =
        (Math.random() - 0.5) * radius * 1.3;

      result[i * 3] = Math.cos(angle) * distance;
      result[i * 3 + 1] = height;
      result[i * 3 + 2] = Math.sin(angle) * distance;
    }

    return result;
  }, [count, radius]);

  useFrame((_, delta) => {
    if (points.current) {
      points.current.rotation.y += delta * 0.035;
    }
  });

  return (
    <points ref={points}>
      <bufferGeometry>
        <bufferAttribute
          attach="attributes-position"
          args={[positions, 3]}
        />
      </bufferGeometry>
      <pointsMaterial
        color={color}
        size={radius > 1 ? 0.035 : 0.018}
        sizeAttenuation
        transparent
        opacity={0.75}
        depthWrite={false}
        blending={THREE.AdditiveBlending}
      />
    </points>
  );
}

function LivingPlanet({
  data,
  selected,
  connecting,
  onSelect,
}: {
  data: PlanetData;
  selected: boolean;
  connecting: boolean;
  onSelect: () => void;
}) {
  const ring = useRef<THREE.Group>(null);
  const core = useRef<THREE.Group>(null);

  const color = PLANET_COLORS[data.category];
  const isCentral = data.id === "origin";
  const radius = isCentral ? 1.35 : 0.52;

  useFrame((state, delta) => {
    if (ring.current) {
      ring.current.rotation.z += delta * 0.055;
      ring.current.rotation.y += delta * 0.025;
    }

    if (core.current) {
      const pulse =
        1 + Math.sin(state.clock.elapsedTime * 1.2) * 0.016;

      core.current.scale.setScalar(pulse);
    }
  });

  return (
    <group position={data.position}>
      <Float
        speed={1.2}
        rotationIntensity={0.08}
        floatIntensity={0.16}
      >
        <group ref={core}>
          <group
            onClick={(event) => {
              event.stopPropagation();
              onSelect();
            }}
            onPointerOver={() => {
              document.body.style.cursor = "pointer";
            }}
            onPointerOut={() => {
              document.body.style.cursor = "auto";
            }}
          >
            <PlanetSurface
              radius={radius}
              color={color}
              selected={selected}
              connecting={connecting}
            />

            <mesh visible={false}>
              <sphereGeometry args={[radius * 1.5, 32, 32]} />
              <meshBasicMaterial />
            </mesh>
          </group>

          <PlanetParticles
            radius={radius}
            color={color}
            count={isCentral ? 180 : 65}
          />

          <group ref={ring}>
            <mesh rotation={[Math.PI / 2.6, 0.2, 0]}>
              <torusGeometry
                args={[radius * 1.65, 0.012, 8, 160]}
              />
              <meshBasicMaterial
                color={color}
                transparent
                opacity={0.8}
                blending={THREE.AdditiveBlending}
              />
            </mesh>

            <mesh rotation={[Math.PI / 2.1, 0.8, 0]}>
              <torusGeometry
                args={[radius * 1.95, 0.006, 8, 160]}
              />
              <meshBasicMaterial
                color="#b9edff"
                transparent
                opacity={0.45}
                blending={THREE.AdditiveBlending}
              />
            </mesh>

            {isCentral && (
              <mesh rotation={[Math.PI / 1.7, 0.35, 0]}>
                <torusGeometry
                  args={[radius * 2.25, 0.004, 8, 160]}
                />
                <meshBasicMaterial
                  color="#ffd6f2"
                  transparent
                  opacity={0.3}
                  blending={THREE.AdditiveBlending}
                />
              </mesh>
            )}
          </group>

          {(selected || connecting) && (
            <mesh rotation={[Math.PI / 2, 0, 0]}>
              <torusGeometry
                args={[radius * 2.45, 0.015, 8, 128]}
              />
              <meshBasicMaterial
                color={connecting ? "#72e5ce" : "#ffffff"}
              />
            </mesh>
          )}
        </group>
      </Float>
    </group>
  );
}

function ConnectionLine({
  source,
  target,
  highlighted,
}: {
  source: PlanetData;
  target: PlanetData;
  highlighted: boolean;
}) {
  const material = useRef<THREE.MeshBasicMaterial>(null);

  const geometry = useMemo(() => {
    const start = new THREE.Vector3(...source.position);
    const end = new THREE.Vector3(...target.position);

    const middle = start.clone().add(end).multiplyScalar(0.5);
    middle.z -= 0.6;

    const curve = new THREE.QuadraticBezierCurve3(
      start,
      middle,
      end
    );

    return new THREE.TubeGeometry(curve, 64, 0.012, 6, false);
  }, [source.position, target.position]);

  useEffect(() => {
    return () => geometry.dispose();
  }, [geometry]);

  useFrame((state) => {
    if (material.current) {
      const pulse =
        0.48 + Math.sin(state.clock.elapsedTime * 1.8) * 0.16;

      material.current.opacity = highlighted
        ? Math.min(1, pulse + 0.3)
        : pulse;
    }
  });

  return (
    <mesh geometry={geometry} raycast={() => []}>
      <meshBasicMaterial
        ref={material}
        color={highlighted ? "#a6fff0" : "#b69aff"}
        transparent
        opacity={0.6}
        depthWrite={false}
      />
    </mesh>
  );
}

function CameraRig({
  planets,
  selectedId,
  resetSignal,
}: {
  planets: PlanetData[];
  selectedId: string | null;
  resetSignal: number;
}) {
  const { camera } = useThree();
  const controls = useRef<OrbitControlsImpl>(null);
  const target = useRef(new THREE.Vector3());
  const destination = useRef(new THREE.Vector3(0, 0, 12));
  const moving = useRef(true);

  const selectedPlanet = planets.find(
    (planet) => planet.id === selectedId
  );

  const selectedPosition = selectedPlanet?.position;

  useEffect(() => {
    if (selectedPosition) {
      target.current.set(...selectedPosition);
      destination.current
        .copy(target.current)
        .add(new THREE.Vector3(0, 0.8, 4.5));
    } else {
      target.current.set(0, 0, 0);
      destination.current.set(0, 0, 12);
    }

    moving.current = true;
  }, [selectedId, selectedPosition, resetSignal]);

  useFrame((_, delta) => {
    if (!controls.current || !moving.current) return;

    const factor = 1 - Math.exp(-delta * 2.5);

    camera.position.lerp(destination.current, factor);
    controls.current.target.lerp(target.current, factor);
    controls.current.update();

    if (
      camera.position.distanceTo(destination.current) < 0.025 &&
      controls.current.target.distanceTo(target.current) < 0.025
    ) {
      moving.current = false;
    }
  });

  return (
    <OrbitControls
      ref={controls}
      makeDefault
      enablePan
      enableDamping
      dampingFactor={0.045}
      minDistance={1.8}
      maxDistance={35}
      autoRotate={!selectedId}
      autoRotateSpeed={0.18}
      onStart={() => {
        moving.current = false;
      }}
    />
  );
}

function CelestialAnomaly() {
