              color="#ffc2e5"
              transparent
              opacity={0.55}
              blending={THREE.AdditiveBlending}
              depthWrite={false}
            />
          </mesh>

          <mesh>
            <torusGeometry args={[3.1, 0.012, 8, 240]} />
