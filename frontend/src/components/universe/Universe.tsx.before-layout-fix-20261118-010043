            <mesh position={[0, -0.88, offset]}>
              <boxGeometry args={[5, 0.015, 0.035]} />
              <meshBasicMaterial
                color="#7b66c6"
                transparent
                opacity={0.4}
              />
            </mesh>
          </group>
        )
      )}

      {buildings.map((building) => (
        <group
          key={building.id}
          position={[building.x, -0.88, building.z]}
          onClick={(event) => {
            event.stopPropagation();
            onBuildingClick(building.id);
          }}
        >
          <mesh
            position={[0, building.height / 2, 0]}
            castShadow
          >
            <boxGeometry
              args={[
                building.width,
                building.height,
                building.width,
              ]}
            />
            <meshStandardMaterial
              color={
                building.kind === 0
                  ? "#302544"
                  : building.kind === 1
                    ? "#1b3349"
                    : "#3c2943"
              }
              metalness={0.7}
              roughness={0.2}
              emissive={color}
              emissiveIntensity={0.08}
            />
          </mesh>

          <mesh
            position={[
              0,
              building.height + 0.015,
              0,
            ]}
          >
            <boxGeometry
              args={[building.width + 0.04, 0.03, building.width + 0.04]}
            />
            <meshBasicMaterial color={color} />
          </mesh>

          {Array.from(
            {
              length: Math.max(
                1,
                Math.floor(building.height / 0.18)
              ),
            },
            (_, floor) => (
              <mesh
                key={floor}
                position={[
                  0,
                  0.12 + floor * 0.18,
                  building.width / 2 + 0.006,
                ]}
              >
                <boxGeometry
                  args={[
                    building.width * 0.65,
                    0.028,
                    0.006,
                  ]}
                />
                <meshBasicMaterial
                  color={
                    floor % 3 === 0
                      ? "#fff0bf"
                      : "#79dfe9"
                  }
                  transparent
                  opacity={0.65}
                />
              </mesh>
            )
          )}
        </group>
      ))}

      <group ref={beacon} position={[0, 0.85, 0]}>
        <mesh>
          <octahedronGeometry args={[0.38, 1]} />
          <meshStandardMaterial
            color={color}
            emissive={color}
            emissiveIntensity={2.5}
            metalness={0.25}
            roughness={0.1}
          />
        </mesh>

        <mesh rotation={[Math.PI / 2, 0, 0]}>
          <torusGeometry args={[0.65, 0.012, 8, 100]} />
          <meshBasicMaterial color="#b7f8ff" />
        </mesh>

        <mesh rotation={[0.5, 0, 0.6]}>
          <torusGeometry args={[0.85, 0.012, 8, 100]} />
          <meshBasicMaterial color={color} />
        </mesh>
      </group>

      {Array.from({ length: 12 }, (_, i) => {
        const angle = (i / 12) * Math.PI * 2;

        return (
          <Float
            key={i}
            speed={1 + (i % 3) * 0.4}
            floatIntensity={0.25}
            rotationIntensity={0.15}
          >
            <mesh
              position={[
                Math.cos(angle) * 2.9,
                0.4 + (i % 4) * 0.4,
                Math.sin(angle) * 2.9,
              ]}
            >
              <octahedronGeometry args={[0.055, 0]} />
              <meshBasicMaterial color="#c5faff" />
            </mesh>
          </Float>
        );
      })}

      <pointLight
        position={[0, 2, 0]}
        color={color}
        intensity={15}
        distance={9}
      />

      <pointLight
        position={[2, 3, 2]}
        color="#74e5e6"
        intensity={9}
        distance={9}
      />
    </group>
  );
}

function HiddenCityCamera({
  position,
}: {
  position: [number, number, number];
}) {
  const { camera } = useThree();
  const controls = useRef<OrbitControlsImpl>(null);
  const moving = useRef(true);

  const focus = useMemo(
    () => new THREE.Vector3(...position),
    [position]
  );

  const destination = useMemo(
    () => focus.clone().add(new THREE.Vector3(0, 2.3, 6.5)),
    [focus]
  );

  useFrame((_, delta) => {
    if (!controls.current || !moving.current) return;

    const factor = 1 - Math.exp(-delta * 1.8);

    camera.position.lerp(destination, factor);
    controls.current.target.lerp(focus, factor);
    controls.current.update();

    if (
      camera.position.distanceTo(destination) < 0.04 &&
      controls.current.target.distanceTo(focus) < 0.04
    ) {
      moving.current = false;
    }
  });

  return (
    <OrbitControls
      ref={controls}
      makeDefault
      enableDamping
      dampingFactor={0.055}
      enablePan
      minDistance={1.1}
      maxDistance={12}
      maxPolarAngle={Math.PI * 0.83}
      onStart={() => {
        moving.current = false;
      }}
    />
  );
}

export default function Universe({
  planets,
  connections,
  selectedId,
  connectingFrom,
  onSelect,
  resetSignal,
}: UniverseProps) {
  const [cityPlanetId, setCityPlanetId] = useState<string | null>(null);
  const [activeBuilding, setActiveBuilding] = useState<number | null>(null);

  const planetMap = useMemo(
    () => new Map(planets.map((planet) => [planet.id, planet])),
    [planets]
  );

  const selectedPlanet = selectedId
    ? planetMap.get(selectedId)
    : undefined;

  const cityPlanet = cityPlanetId
    ? planetMap.get(cityPlanetId)
    : undefined;

  const cityNotes = cityPlanet?.content
    .split(/[.!?\n]+/)
    .map((item) => item.trim())
    .filter(Boolean) ?? [];

  const enterCity = () => {
    if (!selectedPlanet) return;
    setActiveBuilding(null);
    setCityPlanetId(selectedPlanet.id);
  };

  const leaveCity = () => {
    setCityPlanetId(null);
    setActiveBuilding(null);
  };

  return (
    <div
      style={{
        position: "relative",
        width: "100%",
        height: "100%",
        minHeight: "100%",
      }}
    >
      <Canvas
        camera={{ position: [0, 0, 12], fov: 55 }}
        dpr={[1, 1.75]}
        gl={{ antialias: true, alpha: true }}
        onPointerMissed={() => {
          if (!cityPlanet && !connectingFrom) onSelect(null);
        }}
      >
        <color attach="background" args={["#080713"]} />

        <ambientLight intensity={0.65} />

        <pointLight
          position={[5, 4, 5]}
          intensity={65}
          color="#a88bff"
        />

        <pointLight
          position={[-5, -3, 2]}
          intensity={40}
          color="#50e3d0"
        />

        <Stars
          radius={90}
          depth={50}
          count={3500}
          factor={4}
          saturation={0.4}
          fade
          speed={0.5}
        />

        {cityPlanet ? (
          <>
            <HiddenCityScene
              planet={cityPlanet}
              onBuildingClick={setActiveBuilding}
            />
            <HiddenCityCamera position={cityPlanet.position} />
          </>
        ) : (
          <>
            <CelestialAnomaly />

            {connections.map((connection) => {
              const source = planetMap.get(connection.sourceId);
              const target = planetMap.get(connection.targetId);

              if (!source || !target) return null;

              return (
                <ConnectionLine
                  key={connection.id}
                  source={source}
                  target={target}
                  highlighted={
                    selectedId === source.id ||
                    selectedId === target.id
                  }
                />
              );
            })}

            {planets.map((planet) => (
              <LivingPlanet
                key={planet.id}
                data={planet}
                selected={selectedId === planet.id}
                connecting={connectingFrom === planet.id}
                onSelect={() => onSelect(planet.id)}
              />
            ))}

            {planets.map((planet) => (
              <HiddenPlanetWorld
                key={`hidden-${planet.id}`}
                planet={planet}
                selected={selectedId === planet.id}
              />
            ))}

            <CameraRig
              planets={planets}
              selectedId={selectedId}
              resetSignal={resetSignal}
            />
          </>
        )}
      </Canvas>

      {!cityPlanet && selectedPlanet && !connectingFrom && (
        <button
          type="button"
          onClick={enterCity}
          style={{
            position: "absolute",
            bottom: 85,
            left: "50%",
            transform: "translateX(-50%)",
            zIndex: 25,
            padding: "15px 24px",
            borderRadius: 999,
            border: "1px solid rgba(200,170,255,.6)",
            background: "rgba(24,13,48,.93)",
            color: "#f5eaff",
            fontFamily: "inherit",
            fontSize: 11,
            letterSpacing: "0.18em",
            fontWeight: 700,
            cursor: "pointer",
            boxShadow: "0 0 35px rgba(142,94,255,.3)",
            whiteSpace: "nowrap",
          }}
        >
          ✦ ENTER HIDDEN CITY
        </button>
      )}

      {cityPlanet && (
        <div
          style={{
            position: "absolute",
            top: 95,
            left: 25,
            right: 25,
            zIndex: 35,
            display: "flex",
            justifyContent: "space-between",
            alignItems: "flex-start",
            gap: 15,
            pointerEvents: "none",
          }}
        >
          <div
            style={{
              color: "#f6edff",
              textShadow: "0 2px 18px #080713",
              maxWidth: 310,
            }}
          >
            <div
              style={{
                fontSize: 10,
                letterSpacing: "0.22em",
                color: "#b6f2ec",
              }}
            >
              AETHERA / HIDDEN CIVILIZATIONS
            </div>

            <h2
              style={{
                fontFamily: "Georgia, serif",
                fontSize: "clamp(24px, 3vw, 42px)",
                fontWeight: 400,
                margin: "12px 0 8px",
              }}
            >
              {cityPlanet.title}
            </h2>

            <div style={{ fontSize: 12, opacity: 0.8 }}>
              {cityPlanet.category} · Explore the city
            </div>
          </div>

          <button
            type="button"
            onClick={leaveCity}
            style={{
              pointerEvents: "auto",
              padding: "12px 18px",
              borderRadius: 999,
              border: "1px solid rgba(255,255,255,.35)",
              background: "rgba(17,12,35,.9)",
              color: "white",
              cursor: "pointer",
              fontSize: 11,
              letterSpacing: "0.1em",
              whiteSpace: "nowrap",
            }}
          >
            ← RETURN TO SPACE
          </button>
        </div>
      )}

      {cityPlanet && activeBuilding !== null && (
        <div
          style={{
            position: "absolute",
            right: 24,
            bottom: 95,
            width: "min(310px, 85vw)",
            zIndex: 40,
            padding: 22,
            borderRadius: 18,
            border: "1px solid rgba(191,166,255,.4)",
            background: "rgba(17,12,35,.94)",
            color: "#f8efff",
            boxShadow: "0 20px 60px rgba(0,0,0,.45)",
          }}
        >
          <div
            style={{
              fontSize: 10,
              letterSpacing: "0.2em",
              color: "#a7eee5",
            }}
          >
            DISCOVERED STRUCTURE
          </div>

          <h3
            style={{
              fontFamily: "Georgia, serif",
              fontSize: 24,
              fontWeight: 400,
              margin: "12px 0",
            }}
          >
            Archive {String(activeBuilding + 1).padStart(2, "0")}
          </h3>

          <p style={{ fontSize: 13, lineHeight: 1.7 }}>
            {cityNotes.length > 0
              ? cityNotes[activeBuilding % cityNotes.length]
              : "An unexplored structure awaiting your next idea."}
          </p>

          <button
            type="button"
            onClick={() => setActiveBuilding(null)}
            style={{
              marginTop: 10,
              background: "transparent",
              color: "#c8b5fa",
              border: 0,
              cursor: "pointer",
            }}
          >
            CLOSE
          </button>
        </div>
      )}

      {cityPlanet && (
        <div
          style={{
            position: "absolute",
            bottom: 25,
            left: "50%",
            transform: "translateX(-50%)",
            zIndex: 20,
            color: "#d8c6f7",
            fontSize: 10,
            letterSpacing: "0.12em",
            textAlign: "center",
            pointerEvents: "none",
          }}
        >
          DRAG TO EXPLORE · SCROLL TO FLY CLOSER · CLICK BUILDINGS
        </div>
      )}
    </div>
  );
}
